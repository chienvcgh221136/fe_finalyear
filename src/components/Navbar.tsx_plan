// Update to Navbar to use useAuth()
import { useAuth } from '../context/AuthContext';

// Inside Navbar
const { user, isAuthenticated, logout } = useAuth();

// Replace Auth Actions div
<div className="flex items-center gap-6">
    <Link to="/post-ad" className="...">Đăng tin</Link>
    <div className="h-6 w-px bg-gray-200 hidden md:block"></div>
    {isAuthenticated ? (
        <div className="flex items-center gap-4">
            <span className="font-bold text-gray-700">Hello, {user?.name}</span>
            <button onClick={logout} className="...">Logout</button>
        </div>
    ) : (
        <>
            <Link to="/login" className="...">Đăng nhập</Link>
            <Link to="/register" className="...">Đăng ký</Link>
        </>
    )}
</div>
